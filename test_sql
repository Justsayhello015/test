# Ô đọc kết quả bài kiểm (018 đợt 2). Chạy sau ô Cấu hình. Chỉ in mã và số đếm:
# không in tên báo cáo, trang, ô, cột hay giá trị nào.
import json
import textwrap
from collections import Counter
from pathlib import Path

from chatbot.facetest.store import FaceTestStore

folder = Path(FACETEST_DIR)
summary = FaceTestStore(folder).last_finished()
results = [
    r
    for r in FaceTestStore(folder).read_results(summary.run_key)
    if r.status in ("scored", "error")
]
case_file = folder / "cases.json"
cases = json.loads(case_file.read_text(encoding="utf-8"))
if cases["list_id"] != summary.list_id:
    case_file = folder / f"cases-{summary.list_id}.json"
    cases = json.loads(case_file.read_text(encoding="utf-8"))
case_by_id = {case["case_id"]: case for case in cases["cases"]}


def steps_of(result):
    try:
        steps = json.loads(result.tool_calls_log[-1])["steps"]
    except (IndexError, ValueError, KeyError, TypeError):
        return []
    return [step for step in steps if isinstance(step, dict)]


def last(steps, name):
    return next((s for s in reversed(steps) if s.get("step") == name), {})


def source_kind(code):
    # "bảng:loại[:nguồn]" -> "loại[:nguồn]": bỏ tên bảng
    parts = str(code).split(":")
    for i in range(len(parts) - 1, 0, -1):
        if parts[i] in ("external", "derived", "unresolved"):
            return ":".join(parts[i:])
    return "?"


def bucket(n):
    n = n or 0
    return "0" if n == 0 else "1-5" if n <= 5 else "6-20" if n <= 20 else ">20"


all_codes = Counter()
other = Counter()
branch = Counter()
no_match = Counter()
no_sql = Counter()
for result in results:
    case = case_by_id.get(result.case_id, {})
    expects = {t["tile"]["visual_id"]: t for t in case.get("tiles", [])}
    steps = steps_of(result)
    numbers = last(steps, "numbers")
    formula = last(steps, "formula")
    pick = last(steps, "llm_checks").get("calls", {}).get("pick_numbers", {})
    for tile in result.tiles:
        all_codes.update(tile.codes)
        why = next((c[4:] for c in tile.codes if c.startswith("why:")), "")
        expect = expects.get(tile.visual_id, {})
        if why.startswith("other_tile:other_measure"):
            other.update(f"kết quả khớp:{o}" for o in numbers.get("outcomes") or [])
            other.update(f"loại tên:{k}" for k in numbers.get("name_kinds") or [])
            other[f"cụm chữ/ô hỏi:{numbers.get('phrases', 0)}/{len(expects)}"] += 1
        if why == "no_target:branch_listing":
            formula = next(
                (
                    s
                    for s in reversed(steps)
                    if s.get("step") == "formula" and s.get("outcome") == "branch_listing"
                ),
                formula,
            )
            branch[f"kiểu câu:{result.kind}"] += 1
            branch[f"bài kiểm biết nhánh:{'có' if expect.get('branch') else 'không'}"] += 1
            branch[f"lọc trên ảnh:{bucket(len(case.get('slicer_values') or []))}"] += 1
            branch[f"lọc trong câu:{bucket(len(case.get('question_values') or []))}"] += 1
            branch[f"bot biết nhánh từ:{formula.get('branch_source')}"] += 1
            branch[f"nhánh chưa chọn:{bucket(formula.get('unpicked_branches'))}"] += 1
            branch[f"cột chờ chọn:{bucket(len(formula.get('unpicked_columns') or []))}"] += 1
        if why.startswith("no_target:no_match"):
            no_match[f"ứng viên:{bucket(numbers.get('candidates'))}"] += 1
            no_match.update(f"kết quả khớp:{o}" for o in numbers.get("outcomes") or [])
            for key in ("errors", "rules", "checks"):
                no_match.update(f"model chọn {key}:{c}" for c in pick.get(key) or [])
    for step in steps:
        if step.get("step") != "formula" or step.get("sql_status") != "blocked":
            continue
        no_sql[f"chặn:{','.join(step.get('sql_blocks') or []) or 'không mã'}"] += 1
        no_sql.update(f"nguồn ngoài:{source_kind(c)}" for c in step.get("external_tables") or [])
        no_sql[f"tầng cắt:{bucket(step.get('cut_levels'))}"] += 1
        no_sql[f"cây:{step.get('outcome')}"] += 1


def show(title, counter):
    items = sorted(counter.items(), key=lambda x: (-x[1], x[0]))
    text = f"{title}: " + " · ".join(f"{k} {n}" for k, n in items)
    print(textwrap.fill(text, width=100, subsequent_indent="    ", break_on_hyphens=False))


print(f"Lần chạy {summary.run_key[:40]} · câu {len(results)} · ô {sum(len(r.tiles) for r in results)}")
show("A. Mọi mã theo ô", all_codes)
show("B. Ô bot chọn ô khác, chỉ tiêu khác", other)
show("C. Ô bot liệt kê nhánh", branch)
show("D. Ô model không thấy ô nào khớp", no_match)
show("E. Bước bóc bị chặn SQL", no_sql)
