# Ô đọc nguyên nhân hai lỗi thử tay: không ra SQL, DAX in dài (018 đợt 2).
# Chạy ở notebook agent_chat, sau ô `%run ./reportez_setup`. Không gọi model, không ghi gì.
# Chỉ đọc các câu của CHÍNH ANH trong bảng lịch sử chat của app, và chỉ in mã và số đếm:
# không in câu hỏi, câu trả lời, tên báo cáo, trang, bảng, cột hay giá trị nào.
SO_NGAY = 3  # đọc các câu trong mấy ngày gần đây
SO_CAU = 20  # tối đa bao nhiêu câu trả lời gần nhất

import json
import re
from collections import Counter

from chatbot.agent.history import quoted_table

TABLE = quoted_table(CHAT_HISTORY_TABLE)
ME = spark.sql("SELECT current_user()").first()[0]
ROWS = spark.sql(
    f"""
    SELECT role, content, reply_meta, tool_calls_log, rptdate_detail, conversation_code
    FROM {TABLE}
    WHERE user_email = :me AND rptdate_detail >= date_sub(current_date(), {int(SO_NGAY)})
    ORDER BY rptdate_detail DESC
    LIMIT {int(SO_CAU) * 3}
    """,
    args={"me": ME},
).collect()

DAX_BLOCK = re.compile(r"```dax\s(.*?)```", re.DOTALL | re.IGNORECASE)
SQL_BLOCK = re.compile(r"```sql\s(.*?)```", re.DOTALL | re.IGNORECASE)
WORDS = {
    "SWITCH": re.compile(r"\bSWITCH\s*\(", re.IGNORECASE),
    "IF": re.compile(r"\bIF\s*\(", re.IGNORECASE),
    "VAR": re.compile(r"\bVAR\s", re.IGNORECASE),
    "CALCULATE": re.compile(r"\bCALCULATE\s*\(", re.IGNORECASE),
}
OUTSIDE_KINDS = ("external", "derived", "unresolved")


def loaded(text):
    """JSON thành dict; chuỗi rỗng hay hỏng thì {}."""
    if isinstance(text, dict):
        return text
    try:
        value = json.loads(text) if text else {}
    except ValueError:
        return {}
    return value if isinstance(value, dict) else {}


def has_word(text, word):
    return "có" if re.search(rf"\b{word}\b", text or "", re.IGNORECASE) else "không"


def codes(values):
    return "[" + ", ".join(str(v) for v in values or ()) + "]"


def kinds_only(tables):
    """ "bảng:loại[:kiểu nguồn]" -> "loại[:kiểu nguồn]": không in tên bảng."""
    out = []
    for item in tables or ():
        parts = str(item).split(":")
        at = next((i for i, part in enumerate(parts) if part in OUTSIDE_KINDS), None)
        out.append(":".join(parts[at:]) if at is not None else "khác")
    return codes(out)


def dax_shape(dax):
    counts = " · ".join(f"{name} {len(rule.findall(dax))}" for name, rule in WORDS.items())
    return f"{len(dax)} ký tự · {dax.count(chr(10)) + 1} dòng · {counts}"


def formula_lines(label, formula, tally):
    yield (
        f"  lưu {label}: sql_status={formula.get('sql_status')} · có SQL="
        f"{'có' if formula.get('sql') else 'không'} · lời lý do không có SQL "
        f"{len(formula.get('sql_reason') or '')} ký tự · bước Power Query SQL chưa tính "
        f"{len(formula.get('steps_not_in_sql') or ())} · tham số {len(formula.get('placeholders') or ())}"
        f" · đã chọn nhánh={'có' if formula.get('branch_value') else 'không'}"
    )
    stored = formula.get("formulas") or ()
    tally["tầng có DAX lưu lại"] += len(stored)
    for item in stored:
        if isinstance(item, (list, tuple)) and len(item) == 3:
            yield f"    DAX tầng {item[0]}: {dax_shape(str(item[2]))}"


def turn_lines(number, question, row, tally):
    meta = loaded(row["reply_meta"])
    content = row["content"] or ""
    dax_blocks = DAX_BLOCK.findall(content)
    sql_blocks = SQL_BLOCK.findall(content)
    yield (
        f"Câu {number} · hỏi có chữ sql={has_word(question, 'sql')}, dax={has_word(question, 'dax')}"
        f", code={has_word(question, 'code')} · trả lời kiểu {meta.get('action')}/{meta.get('rule_id')}"
        f" · dài {len(content)} ký tự · khối DAX {len(dax_blocks)} ({sum(map(len, dax_blocks))} ký tự)"
        f" · khối SQL {len(sql_blocks)} ({sum(map(len, sql_blocks))} ký tự)"
    )
    for block in dax_blocks:
        yield f"    DAX in ra: {dax_shape(block)}"
    steps = loaded(row["tool_calls_log"]).get("steps") or ()
    steps = [loaded(step) for step in steps]
    formula_steps = [step for step in steps if step.get("step") == "formula"]
    if not steps:
        yield "  (không có nhật ký của câu này)"
    elif not formula_steps:
        names = Counter(str(step.get("step")) for step in steps)
        yield "  không có bước bóc công thức; các bước: " + codes(sorted(names))
    for step in formula_steps:
        tally[f"outcome {step.get('outcome')}"] += 1
        tally[f"sql_status {step.get('sql_status')}"] += 1
        for check in step.get("sql_checks") or ():
            tally[f"sql_check {check}"] += 1
        for block in step.get("sql_blocks") or ():
            tally[f"sql_block {block}"] += 1
        yield (
            f"  bóc: outcome={step.get('outcome')} · reason={step.get('reason')} · found_by="
            f"{step.get('found_by')} · tầng {step.get('levels')} · lọc {step.get('filters')} · nối "
            f"{step.get('joins')} · dài {step.get('tree_tokens')} · cắt {step.get('cut_levels')} tầng"
            f" · gọi model {step.get('calls')} · sửa lại {step.get('retries')} · lỗi "
            f"{codes(step.get('errors'))} · kiểm chữ {codes(step.get('checks'))}"
        )
        yield (
            f"  SQL: sql_status={step.get('sql_status')} · kế hoạch={step.get('sql_plan')} · chặn "
            f"{codes(step.get('sql_blocks'))} · chỗ trống {step.get('sql_gaps')} · theo ô "
            f"{step.get('sql_as_tile')} · bảng Power BI {step.get('sql_pbi_tables')} · kiểm SQL "
            f"{codes(step.get('sql_checks'))} · hiện SQL={step.get('sql_shown')} · hiện DAX="
            f"{step.get('dax_shown')} · bảng ngoài kho {kinds_only(step.get('external_tables'))}"
        )
        yield (
            f"  nhánh: branch_source={step.get('branch_source')} · nhánh chưa chọn "
            f"{step.get('unpicked_branches')} · cột chờ chọn {len(step.get('unpicked_columns') or ())}"
            f" · lý do không có mặc định={step.get('branch_no_default')}"
        )
    if meta.get("formula"):
        yield from formula_lines("(một số)", loaded(meta["formula"]), tally)
    for position, item in enumerate(meta.get("numbers") or (), start=1):
        yield from formula_lines(f"(số {position})", loaded(loaded(item).get("formula")), tally)


def report(rows):
    """Các dòng in ra: câu mới nhất trước; cuối cùng là bảng đếm."""
    ordered = sorted(rows, key=lambda row: (str(row["rptdate_detail"]), row["role"] != "user"))
    asked = {}
    turns = []
    for row in ordered:
        if row["role"] == "user":
            asked[row["conversation_code"]] = row["content"] or ""
        elif row["role"] == "assistant":
            turns.append((asked.get(row["conversation_code"], ""), row))
    turns = turns[::-1][: int(SO_CAU)]
    tally = Counter()
    lines = [f"Đọc {len(turns)} câu trả lời gần nhất trong {int(SO_NGAY)} ngày (mới nhất trước)."]
    for number, (question, row) in enumerate(turns, start=1):
        lines.extend(turn_lines(number, question, row, tally))
    lines.append(
        "Đếm: " + " · ".join(f"{name} {count}" for name, count in sorted(tally.items()))
    )
    return lines


print("\n".join(report(ROWS)))
