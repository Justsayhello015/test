SELECT get_json_object(reply_meta, '$.action')                   AS action,
       tool_calls_log IS NULL                                    AS log_trong,
       get_json_object(tool_calls_log, '$.steps[*].outcome')     AS boc_kq,
       get_json_object(tool_calls_log, '$.steps[*].errors')      AS loi,
       get_json_object(tool_calls_log, '$.steps[*].checks')      AS kiem_hong,
       get_json_object(tool_calls_log, '$.steps[*].levels')      AS so_tang,
       get_json_object(tool_calls_log, '$.steps[*].filters')     AS so_loc,
       get_json_object(tool_calls_log, '$.steps[*].tree_tokens') AS do_dai,
       get_json_object(tool_calls_log, '$.steps[*].cut_levels')  AS tang_bi_cat
FROM `<catalog>`.`<schema>`.`chatbot_message`
WHERE role = 'assistant' AND user_email = '<email của anh>'
  AND to_date(rptdate_detail) >= date_sub(current_date(), 1)
ORDER BY rptdate_detail DESC
LIMIT 3;
