SELECT rptdate_detail                                          AS luc,
       get_json_object(reply_meta, '$.action')                 AS action,
       get_json_object(reply_meta, '$.thinking.steps[*].key')  AS cac_buoc,
       tool_calls_log IS NULL                                  AS log_trong,
       get_json_object(tool_calls_log, '$.steps[*].reason')    AS tim_so_ket_qua,
       get_json_object(tool_calls_log, '$.steps[*].outcome')   AS boc_cong_thuc
FROM `<catalog>`.`<schema>`.`chatbot_message`
WHERE role = 'assistant'
  AND user_email = '<email của anh>'
  AND to_date(rptdate_detail) >= date_sub(current_date(), 1)
ORDER BY luc DESC
LIMIT 3;
