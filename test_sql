WITH steps AS (
  SELECT rptdate_detail AS at,
         explode(from_json(tool_calls_log, 'struct<steps:array<string>>').steps) AS step
  FROM `<catalog>`.`<schema>`.`<bảng lịch sử chat>`
  WHERE role = 'assistant' AND tool_calls_log IS NOT NULL
    AND to_date(rptdate_detail) >= date_sub(current_date(), 1)
)
SELECT at,
       get_json_object(step, '$.outcome')           AS outcome,
       get_json_object(step, '$.levels')            AS levels,
       get_json_object(step, '$.filters')           AS filters,
       get_json_object(step, '$.branch_source')     AS branch_source,
       get_json_object(step, '$.unpicked_branches') AS unpicked_branches,
       get_json_object(step, '$.sql_status')        AS sql_status,
       get_json_object(step, '$.errors')            AS errors,
       get_json_object(step, '$.checks')            AS checks
FROM steps
WHERE get_json_object(step, '$.step') = 'formula'
ORDER BY at DESC;
