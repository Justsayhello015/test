import json, pathlib, collections
runs = sorted(pathlib.Path(f"{FACETEST_DIR}/runs").iterdir(), key=lambda p: p.stat().st_mtime)
dem = collections.Counter()
for line in open(runs[-1] / "results.jsonl", encoding="utf-8"):
    r = json.loads(line)
    if r["status"] != "scored":
        continue
    meta = json.loads(r["reply_meta"][-1] or "{}")
    steps = json.loads(r["tool_calls_log"][-1] or "{}").get("steps", [])
    if any(s["step"] == "numbers" for s in steps):
        continue
    hieu = next((s for s in steps if s["step"] == "understand"), {})
    khoa = (r["kind"], meta.get("intent"), meta.get("action"), meta.get("rule_id"), hieu.get("fallback"))
    print(*khoa, "| số lượt:", len(r["tool_calls_log"]))
    dem[khoa[1:]] += 1
for khoa, so in dem.most_common():
    print(so, khoa)
